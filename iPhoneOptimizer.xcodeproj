name: Build iOS

on:
  push:
    branches: [ "main" ]
  workflow_dispatch:

jobs:
  build:
    runs-on: macos-latest

    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      # Tự động cài đặt CocoaPods nếu có file Podfile
      - name: Install Dependencies
        run: |
          if [ -f "Podfile" ]; then
            pod install
          fi

      # Tự động tìm Project hoặc Workspace để build
      - name: Build
        run: |
          if [ -d "*.xcworkspace" ] || [ -f "*.xcworkspace" ]; then
            xcodebuild -workspace iPhoneOptimizer.xcworkspace \
              -scheme iPhoneOptimizer \
              -sdk iphonesimulator \
              -configuration Debug \
              CODE_SIGNING_ALLOWED=NO \
              CODE_SIGNING_REQUIRED=NO \
              CODE_SIGN_IDENTITY="" 
          else
            xcodebuild -project iPhoneOptimizer.xcodeproj \
              -scheme iPhoneOptimizer \
              -sdk iphonesimulator \
              -configuration Debug \
              CODE_SIGNING_ALLOWED=NO \
              CODE_SIGNING_REQUIRED=NO \
              CODE_SIGN_IDENTITY="" 
          fi
